# ---------------------------------------------------------------------------
# Roostoo Quant Trading Hackathon bot -- configuration template.
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real keys.
#
# Portfolio defaults below already match the team's playbook (Rules 7-12).
# ---------------------------------------------------------------------------

# --- Credentials (issued by Roostoo / the organisers) -----------------------
ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Set to 1 to run against the built-in simulated exchange (no keys, no network).
ROOSTOO_MOCK=0

# --- Rule 1: universe -------------------------------------------------------
# Comma separated. Leave EMPTY to auto-discover every tradable pair and rank by
# 24h turnover. Listing pairs explicitly keeps the ranking *within* that list.
ROOSTOO_PAIRS=
ROOSTOO_MAX_PAIRS=8
MAX_SPREAD_BPS=10            # Rule 1 clause 2: reject spread above 0.1%
# Depth within +/-0.5% of mid must exceed this ($X in Rule 1).
DEPTH_TARGET_NOTIONAL=2000
DEPTH_BAND_PCT=0.005
# none   = do not check depth (correct for a historical backtest)
# binance= real L2 depth from Binance as a liquidity proxy (live only)
# roostoo= a Roostoo depth path, once the organisers confirm one exists
# ticker = rough estimate from 24h turnover (an assumption, not a measurement)
# The organisers confirmed the mock venue's prices follow Binance, so Binance's L2
# book is now a legitimate proxy for "is this asset liquid". Caveat: it measures
# MARKET liquidity, not the mock venue's own depth.
# WARNING: binance FAILS CLOSED -- if Binance's depth endpoint is unreachable,
# every pair is excluded and the bot silently stops trading. That is a bad failure
# mode inside a scored window that needs >=8 active trading days, so `none` ships
# as the default. Flip to `binance` after `run_live.py --check` confirms depth
# connectivity, and watch the journal for "depth unavailable (fail-closed)".
DEPTH_PROVIDER=none
ROOSTOO_DEPTH_PATH=
DEPTH_LIQUIDITY_SHARE=0.02   # only used by DEPTH_PROVIDER=ticker

# Cross-venue basis alarm. The venue tracks Binance, so a wide basis means a wrong
# symbol (USDT vs USD) or a stale feed -- not "a related market". Pairs beyond the
# threshold are excluded for that bar and every reading is journalled. Unlike the
# depth check this FAILS OPEN, because a Binance outage must not stop trading.
# Unset uses 0.01 (1%); tighten to ~0.002 once you have a day of real basis data.
BASIS_MAX_PCT=0.01

# --- Loop ------------------------------------------------------------------
BAR_SECONDS=1800             # 30-minute bars: the unit of Rules 2-6
# Keep >= 30: the rules forbid HFT and the exchange throttles request bursts.
LOOP_INTERVAL_SEC=60
HISTORY_WINDOW=500
REQUEST_TIMEOUT_SEC=15
MAX_RETRIES=3
MIN_REQUEST_INTERVAL_SEC=0.25

# --- Capital & portfolio risk (Rules 7-12) ---------------------------------
INITIAL_CAPITAL=100000
RISK_PER_TRADE_PCT=0.005     # Rule 7: max loss per trade = 0.5% of portfolio
MAX_PAIR_WEIGHT=0.15         # Rule 8: no single coin above 15% of NAV
MAX_GROSS_EXPOSURE=0.60      # Rule 9: gross exposure <= 60% of NAV
MAX_OPEN_POSITIONS=4         # Rule 10: at most four coins at once
MAX_DAILY_LOSS_PCT=0.02      # Rule 11: -2% day halts new entries
TRADING_DAY_OFFSET_HOURS=8   # Rule 11 day boundary: 00:00-23:59 UTC+8
COOLDOWN_BARS=2              # Rule 12: 2 bars (1h) after an exit
MIN_ORDER_NOTIONAL=25        # skip dust orders; fees eat them

# --- Protective exits (Rules 5-6; owned by a teammate -- tune or disable) ---
STOP_ATR_MULT=1.5            # Rule 5: stop at 1.5 x ATR(14); empty disables
MAX_HOLD_BARS=12             # Rule 6: time stop after 12 bars (6h); empty disables
STOP_LOSS_PCT=               # percentage-stop fallback when ATR is unavailable
TAKE_PROFIT_PCT=             # empty = disabled (not in the playbook)
TRAILING_STOP_PCT=           # empty = disabled (not in the playbook)
# Hard kill switch: flatten everything and stop for the rest of the run.
MAX_DRAWDOWN_PCT=0.20

# --- Costs (per the published rulebook; used by the backtester) ------------
TAKER_FEE=0.001
MAKER_FEE=0.0005
SLIPPAGE_BPS=5

# --- Strategy (Rules 2-3, with Rule 4's deviation gate) --------------------
STRATEGY=roostoo.strategies.mean_reversion:MeanReversionStrategy
# Rule 2: window=48 bars (24h), z_entry=2.0, exits at -0.25 / +0.25.
# Rule 3: adx_period=14, adx_max=25.
# The four supplementary filters default to false -- switch them on one at a
# time and keep only the ones that improve the out-of-sample backtest.
STRATEGY_PARAMS={"window":48,"z_entry":2.0,"z_exit_long":-0.25,"z_exit_short":0.25,"adx_period":14,"adx_max":25.0,"min_abs_deviation":0.006,"allow_short":true,"enable_return_shock_filter":false,"enable_vwap_filter":false,"enable_relative_volume_filter":false,"enable_vol_expansion_filter":false}

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
JOURNAL_DIR=journal
LOG_DIR=logs

# --- Metrics convention ----------------------------------------------------
# Ratios are annualised from daily equity marks (365 for a 24/7 crypto venue).
PERIODS_PER_YEAR=365
RISK_FREE_RATE=0
