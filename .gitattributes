# This project is developed on Windows and deployed to Linux (AWS EC2 +
# systemd). Force LF for anything a Unix tool parses literally: a stray CRLF in
# a systemd unit silently breaks ExecStart, and CRLF in a shell script breaks
# shebang handling.
* text=auto

*.sh      text eol=lf
*.ps1     text eol=lf
*.service text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.csv     text eol=lf
*.example text eol=lf

# Regenerated artefacts: never let Git try to diff or merge them.
*.jsonl   -text
*.log     -text
